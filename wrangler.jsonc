{
  "name": "shikshak",
  "main": "backend/worker.ts",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://nkvjnawnnkrgpyacojfg.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_TYBZMRr51-xS8AhFqD3rFw_IxQM_zTP"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEMO_SESSIONS",
        "class_name": "DemoSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DemoSession"
      ]
    }
  ],
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "DEMO_SESSIONS",
          "class_name": "DemoSession"
        }
      ]
    },
    "vars": {
      "SUPABASE_URL": "https://nkvjnawnnkrgpyacojfg.supabase.co",
      "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_TYBZMRr51-xS8AhFqD3rFw_IxQM_zTP"
    }
  }
}
