# Default (no setting required): local browser-only demo with fictional accounts.
# Set to api only AFTER the Cloudflare/API backend is fully integrated.
# VITE_SERVICE_MODE=local
# VITE_SERVICE_MODE=api

# Only used when VITE_SERVICE_MODE=api:
# The default HTTP API is served by the Shikshak demo Worker.
VITE_API_BASE_URL=/api/v1

# MapLibre now renders the committed Atlas Pastel City recipe over OpenFreeMap Positron.
# See src/maps/atlas-theme-v1.json and src/atlasTheme.ts to change the theme.
# The map theme is independent of the app UI theme.

# Public Photon-compatible geocoder; the UI searches only when submitted.
VITE_GEOCODER_BASE_URL=https://photon.komoot.io
