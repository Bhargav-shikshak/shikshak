# The default HTTP API is served by the Shikshak demo Worker.
VITE_API_BASE_URL=/api/v1

# Leaflet raster basemap: always light, independent of the app theme.
# Choose a provider with suitable capacity before launching at scale.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_MAX_ZOOM=19
# Optionally override VITE_TILE_ATTRIBUTION when using another tile provider.

# Public Photon-compatible geocoder; the UI searches only when submitted.
VITE_GEOCODER_BASE_URL=https://photon.komoot.io
